<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004643"
    android:orientation="vertical"
    tools:context=".ui.UserProfile.UserProfileFragment" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_margin="15dp"
        android:src="@drawable/logo_only" />
    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="Profile Page"
        android:textColor="#F8F6F6"
        android:textSize="50sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="372dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:background="@drawable/monthlygoalshape">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/Achievementsbtn"
            android:layout_width="329dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:background="@drawable/rounded_profile_button"
            android:text="Achievements" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/CreateCategorybtn"
            android:layout_width="329dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:background="@drawable/rounded_profile_button"
            android:text="Create Category" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/UserFeedbackbtn"
            android:layout_width="329dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:background="@drawable/rounded_profile_button"
            android:text="User Feedback"
            android:onClick="onUserFeedbackClick" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/Friendsbtn"
            android:layout_width="329dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:background="@drawable/rounded_profile_button"
            android:text="Friends"
            android:onClick="onFriendsClick" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account controls"
            android:layout_gravity="center_horizontal"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"
            android:textSize="21sp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D3D3D3"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/DeleteAccountbtn"
            android:layout_width="329dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_profile_button"
            android:text="Delete Account"
            android:onClick="onDeleteAccountClick"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/Logoutbtn"
            android:layout_width="329dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_profile_button"
            android:text="Logout"
            android:onClick="onLogoutClick"/>
    </LinearLayout>
    </LinearLayout>
</ScrollView>
